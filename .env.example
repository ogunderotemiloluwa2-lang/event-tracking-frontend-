# Frontend environment variables (Create React App).
# Copy to ".env.production" for a production build, or set these in the
# Vercel dashboard (Project > Settings > Environment Variables).
# Only variables prefixed with REACT_APP_ are exposed to the browser.

# Base URL of the backend API. MUST include the /api/v1 suffix.
REACT_APP_API_URL=https://your-backend.onrender.com/api/v1
